# Snyk (https://snyk.io) policy file for the Sanity Studio workspace.
# Mirrors the root `.snyk`; the Snyk CLI resolves the policy relative to the
# manifest passed via `--file=studio/package.json` in `.github/workflows/snyk-scan.yml`.
version: v1.25.0
ignore:
  SNYK-JS-BRACES-19963945:
    - "*":
        reason: >-
          Uncontrolled Recursion in braces@3.0.3. No patched release exists -
          3.0.3 is the current `latest` on npm, so an override cannot resolve
          it. Reached only through Sanity CLI build tooling
          (sanity > @sanity/cli > @sanity/codegen > chokidar > braces), which
          expands glob patterns from committed config files, never from user
          or network input. Not part of any deployed runtime bundle.
          Revisit when chokidar/micromatch ship a patched braces, or when
          @sanity/codegen moves to chokidar v4 (which drops braces entirely).
        created: 2026-11-06T00:00:00.000Z
        expires: 2027-02-04T00:00:00.000Z
patch: {}
