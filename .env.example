NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-05-01

# EmailJS browser configuration (public identifiers, not server-side secrets)
# JavaScript is required to send the contact form.
NEXT_PUBLIC_EMAIL_API_KEY=your_emailjs_public_key
NEXT_PUBLIC_EMAIL_TEMPLATE_KEY=your_emailjs_template_id
NEXT_PUBLIC_EMAIL_SERVICE_KEY=your_emailjs_service_id

# On-demand revalidation secret (generate a random string)
# Used for /api/revalidate endpoint called by Sanity webhooks
REVALIDATE_SECRET=your_random_secret_here
