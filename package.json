{
  "name": "dfweb-v4",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev": "next dev --turbopack",
    "lhci": "lhci autorun",
    "lhci:perf": "lhci autorun --collect.settings.preset=perf",
    "lhci:desktop": "lhci autorun --collect.settings.preset=desktop",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:css:fix": "stylelint \"src/**/*.css\" --fix",
    "format": "prettier --write \"**/*.{ts,tsx,json}\"",
    "test": "NODE_OPTIONS='--no-experimental-strip-types' jest --coverage --collectCoverageFrom='src/components/**/*.{js,jsx,ts,tsx}' --collectCoverageFrom='!src/components/Animations/Matrix.component.{js,jsx,ts,tsx}' --collectCoverageFrom='!src/components/Animations/types/**'",
    "test:watch": "NODE_OPTIONS='--no-experimental-strip-types' jest --watch",
    "cypress:open": "cypress open",
    "cypress:headless": "cypress run",
    "e2e": "start-test dev 3000 cypress:headless",
    "refresh": "pnpm i && rm -rf node_modules && rm pnpm-lock.yaml && pnpm store prune && pnpm i && pnpm format",
    "ladle": "ladle serve",
    "typegen": "npx sanity typegen generate",
    "doctor": "react-doctor . --verbose"
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "@hookform/resolvers": "^5.8.0",
    "@portabletext/react": "^8.0.0",
    "@sanity/client": "^7.26.2",
    "@sanity/image-url": "^2.1.1",
    "@vercel/speed-insights": "2.0.0",
    "babel-jest": "30.4.1",
    "jest": "30.4.2",
    "motion": "^13.1.0",
    "next": "^16.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-error-boundary": "^6.1.2",
    "react-hook-form": "^7.85.0",
    "react-icons": "^5.7.0",
    "ts-node": "^10.9.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@jest/expect": "^30.4.1",
    "@jest/globals": "^30.4.1",
    "@ladle/react": "^5.1.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/cypress": "^10.1.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@typescript-eslint/utils": "^8.67.0",
    "axe-core": "^4.13.0",
    "cypress": "15.20.1",
    "cypress-axe": "^1.7.0",
    "eslint": "10.8.1",
    "eslint-config-next": "16.3.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.16.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-test-rules": "file:src/utils/eslint",
    "eslint-plugin-testing-library": "^7.16.2",
    "jest-environment-jsdom": "^30.4.1",
    "jest-extended": "^7.0.0",
    "jsdom-testing-mocks": "^1.16.0",
    "pa11y": "^9.1.1",
    "postcss": "^8.5.26",
    "postcss-load-config": "^6.0.1",
    "prettier": "3.9.6",
    "react-doctor": "^0.9.12",
    "sanity": "6.9.2",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "tailwindcss": "^4.3.3",
    "ts-jest": "^29.4.12",
    "typescript": "^6.0.3",
    "wait-on": "^9.1.0"
  },
  "browserslist": [
    "chrome >= 92",
    "firefox >= 90",
    "safari >= 15.4",
    "edge >= 92"
  ]
}
